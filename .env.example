# Production environment for SchoolDrop (SPRING_PROFILES_ACTIVE=prod).
# Every variable without a default must be set; the app refuses to start otherwise.
# Generate secrets with:  openssl rand -base64 48   (CRYPTO_KEY: openssl rand -base64 32)

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8097

# Postgres 17 (managed)
DB_URL=jdbc:postgresql://db.example.internal:5432/schooldrop?sslmode=require
DB_USERNAME=schooldrop_app
DB_PASSWORD=
DB_POOL_SIZE=20

# Secrets
JWT_SECRET=
# AES-256 key for Omang / licence / payout account columns. BACK IT UP — losing it makes them unreadable.
CRYPTO_KEY=
PAYMENT_WEBHOOK_SECRET=

# Web origins allowed to call the API (admin panel, school portal, parent web)
CORS_ORIGINS=https://app.schooldrop.co.bw,https://admin.schooldrop.co.bw

# S3-compatible object storage for driver documents (MinIO, Cloudflare R2, AWS S3, DO Spaces). Keep the bucket private.
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=schooldrop-documents

# Payments: "sandbox" until a real gateway is implemented
PAYMENT_GATEWAY=sandbox
PLATFORM_FEE_PERCENT=10

# Printed on receipts, invoices and statements. Leave the VAT number empty until VAT registered.
BILLING_COMPANY_NAME=SchoolDrop (Pty) Ltd
BILLING_COMPANY_ADDRESS=Gaborone, Botswana
BILLING_COMPANY_REGISTRATION=
BILLING_SUPPORT_EMAIL=support@schooldrop.co.bw
BILLING_VAT_NUMBER=
BILLING_VAT_PERCENT=14

# First admin (only used while no admin exists). Change the password after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional
API_DOCS_ENABLED=false
RATE_LIMIT_AUTH_PER_MINUTE=20
